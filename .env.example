# 先复制本文件为 .env，再根据需要修改；密钥只保存在本机。
# mock 为本地模拟；live 使用真实模型，发送前需在网页确认。
AI_MODE=mock
PORT=4392
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=
AI_THINKING=disabled
AI_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=4096
AI_TOKEN_LIMIT_FIELD=max_tokens
MAX_TEXT_LENGTH=30000
MAX_FILE_BYTES=5242880

# PDF 提取需要 Python 和 pypdf；如未被自动找到，可指定解释器绝对路径。
# PYTHON=C:\Python312\python.exe
